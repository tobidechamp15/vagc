# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/church_members?retryWrites=true&w=majority

# Connection pool size per serverless instance (default: 5).
# Lower = fewer connections to MongoDB Atlas (free tier limit: 500).
# 5 is optimal for single-threaded Next.js API routes on Vercel.
# Increase to 10-20 only if on a dedicated cluster (M10+) with high concurrency.
DB_POOL_SIZE=5

# Church info
CHURCH_NAME="Your Church Name"

# Email (Gmail App Password) -- used by nodemailer
# The code also accepts the legacy names GMAIL_USER / GMAIL_APP_PASSWORD.
EMAIL_USER=your-church-account@gmail.com
EMAIL_PASS=your-16-char-app-password

# Secret used to protect the cron endpoint (Vercel Cron sends this as a header)
CRON_SECRET=replace-with-a-long-random-string

# Secret used to sign login/session tokens (JWT) -- use a long random string
JWT_SECRET=replace-with-another-long-random-string
