# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/church_members?retryWrites=true&w=majority

# Church info
CHURCH_NAME="Your Church Name"

# Email (Gmail App Password) -- used by nodemailer
GMAIL_USER=your-church-account@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Secret used to protect the cron endpoint (Vercel Cron sends this as a header)
CRON_SECRET=replace-with-a-long-random-string

# Secret used to sign login/session tokens (JWT) -- use a long random string
JWT_SECRET=replace-with-another-long-random-string
