# Public site base URL — used by lib/site.ts to build robots.txt / sitemap.xml
# (app/robots.ts, app/sitemap.ts). PRODUCTION-ONLY value: set it in the Vercel
# project's Environment Variables (Production scope), never commit it here.
# It must be the real public domain with scheme and NO trailing slash, e.g.
# https://victoryandglorycenter.org. If left unset, getSiteBaseUrl() falls back
# to VERCEL_PROJECT_PRODUCTION_URL, then to a placeholder — so set this before
# going live so search engines crawl the real domain.
# NEXT_PUBLIC_BASE_URL=https://your-production-domain.example

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/church_members?retryWrites=true&w=majority

# Connection pool size per serverless instance (default: 5).
# Lower = fewer connections to MongoDB Atlas (free tier limit: 500).
# 5 is optimal for single-threaded Next.js API routes on Vercel.
# Increase to 10-20 only if on a dedicated cluster (M10+) with high concurrency.
DB_POOL_SIZE=5

# Mongoose auto-indexing. Defaults: on for development, OFF for production
# (production indexes are built explicitly by `npm run create:indexes` at
# deploy time — see scripts/create-indexes.js). Override per environment with
# AUTO_INDEX=true / AUTO_INDEX=false when you need the opposite.
# AUTO_INDEX=true

# Church info
CHURCH_NAME="Victory and Glory Center"

# Email (Gmail App Password) -- used by nodemailer
# The code also accepts the legacy names GMAIL_USER / GMAIL_APP_PASSWORD.
EMAIL_USER=your-church-account@gmail.com
EMAIL_PASS=your-16-char-app-password

# Secret used to protect the cron endpoint (Vercel Cron sends this as a header)
CRON_SECRET=replace-with-a-long-random-string

# Secret used to sign login/session tokens (JWT) -- use a long random string
JWT_SECRET=replace-with-another-long-random-string

# Cloudinary (object storage for post images/audio/video)
# Dashboard: https://cloudinary.com/console -> Account Details
# NOTE: the API Secret is sensitive — never expose it to the client. The backend
# only uses it to sign direct-upload requests; the raw file bytes always go
# straight from the browser/mobile client to Cloudinary, never through a Vercel
# function (which caps request bodies at ~4.5MB).
#
# Large sermon video: direct uploads are capped at 100MB. For bigger files pass
# a chunkSize (5MB–90MB) to POST /api/upload/signature so the client uses a
# chunked upload. Sermon video is stored as an adaptive HLS (.m3u8) manifest
# (sp_auto streaming profile) so the mobile app streams instead of downloading
# the whole file.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional: folder inside your Cloudinary account where all uploads land.
# Subfolders can be created per resource type by the client (e.g. posts/video).
CLOUDINARY_UPLOAD_FOLDER=church-member-app

# Expo Push (DEV-26) -- required to SEND push notifications to the mobile app
# from a production (non-development) Expo project. Get one at:
# https://expo.dev/accounts/<your-account>/settings/access-tokens
# Leave unset for local development (Expo lets dev builds send without it).
EXPO_ACCESS_TOKEN=your-expo-access-token

# Weekly reminder pushed by the /api/notifications/send cron job (Vercel Cron,
# Mondays 09:00 UTC -- see vercel.json). Customize the message here so the
# church can tune it without a code deploy.
PUSH_CRON_TITLE="Church Reminder"
PUSH_CRON_BODY="A gentle reminder about this week's services and events at church."

# Rate limiting on public writes (DEV-30) -- optional overrides.
# Each is "<limit>:<windowMs>" (requests per window). Leave unset to use the
# defaults defined in lib/rateLimit.ts (RATE_LIMITS). Overrides apply globally
# to every route sharing that preset:
#   RATE_LIMIT_REGISTER=10:3600000        # 10 signups / hour / IP
#   RATE_LIMIT_LOGIN=20:900000            # 20 attempts / 15 min / IP
#   RATE_LIMIT_FORGOT_PASSWORD=5:900000   # 5 reset emails / 15 min / IP
#   RATE_LIMIT_RESET_PASSWORD=10:900000   # 10 reset attempts / 15 min / IP
#   RATE_LIMIT_PRAYER_SUBMIT=10:600000    # 10 prayer requests / 10 min / IP
#   RATE_LIMIT_SUPPORT_SUBMIT=10:600000   # 10 support tickets / 10 min / IP
#   RATE_LIMIT_INTERACTION_DEVICE=60:60000  # per-device taps / min
#   RATE_LIMIT_INTERACTION_IP=240:60000     # per-IP taps / min
